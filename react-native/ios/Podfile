# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-sdk consumes the Dimx iOS SDK as a Swift package (see
# spm_dependency in its podspec). React Native merges SPM static libraries into
# the consuming pod's archive, so with statically linked pods ARCore's products
# land in libreact-native-sdk.a several times over and the link fails on
# duplicate symbols. Dynamic frameworks are required, not merely preferred.
ENV['USE_FRAMEWORKS'] ||= 'dynamic'

# The Dimx iOS SDK is iOS 16.4 and up.
platform :ios, '16.4'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SampleApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Building pods as dynamic frameworks (required for the SPM products, see
    # USE_FRAMEWORKS above) turns React-Core's own includes of yoga/Yoga.h into
    # errors, because React Native ships no modulemap for those headers. The
    # module builder needs to be told the includes are allowed.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
