# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-sdk consumes the Dimx iOS SDK as a Swift package (see
# spm_dependency in its podspec). React Native merges SPM static libraries into
# the consuming pod's archive, so with statically linked pods ARCore's products
# land in libreact-native-sdk.a several times over and the link fails on
# duplicate symbols. Dynamic frameworks are required, not merely preferred.
ENV['USE_FRAMEWORKS'] ||= 'dynamic'

# The Dimx iOS SDK is iOS 16.4 and up.
platform :ios, '16.4'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SampleApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Building pods as dynamic frameworks (required for the SPM products, see
    # USE_FRAMEWORKS above) turns React-Core's own includes of yoga/Yoga.h into
    # errors, because React Native ships no modulemap for those headers. The
    # module builder needs to be told the includes are allowed.
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end

    # Archiving collects every xcframework's .signature into the archive once per
    # target that processed the framework. The SDK's binary targets are processed
    # for the bridge pod (its own build directory) and again for the app, and the
    # second copy fails the archive: "openal.xcframework-ios.signature couldn't be
    # copied to Signatures because an item with the same name already exists" -
    # an Xcode bug since 15.0 (FB12373687), still there in 26.x. A plain build
    # never runs the collection, so only an archive shows it. The known way past
    # it (maplibre-react-native #1490) is a phase on the app target that drops the
    # app's copies before the archive collects them; the pod's copies remain.
    installer.aggregate_targets.each do |aggregate|
      aggregate.user_project.targets.each do |target|
        next unless target.name == 'SampleApp'
        phase_name = '[DimensionX] Remove duplicate xcframework signatures'
        next if target.shell_script_build_phases.any? { |phase| phase.name == phase_name }
        phase = target.new_shell_script_build_phase(phase_name)
        phase.shell_script = 'rm -f "$CONFIGURATION_BUILD_DIR"/*.xcframework-ios.signature'
        phase.always_out_of_date = '1'
      end
      aggregate.user_project.save
    end
  end
end
